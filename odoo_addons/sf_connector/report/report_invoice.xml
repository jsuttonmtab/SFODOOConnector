<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paper: mTab LLC prints on US Letter, G.A.M.M.A on A4 (the NetSuite layouts). -->
    <record id="paperformat_sf_letter" model="report.paperformat">
        <field name="name">SF Invoice - US Letter</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">14</field>
        <field name="margin_right">14</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>
    <record id="paperformat_sf_a4" model="report.paperformat">
        <field name="name">SF Invoice - A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">40</field>
        <field name="margin_bottom">28</field>
        <field name="margin_left">14</field>
        <field name="margin_right">14</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">35</field>
        <field name="dpi">90</field>
    </record>

    <record id="report_sf_invoice_llc" model="ir.actions.report">
        <field name="name">Invoice (mTab LLC)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_connector.report_sf_invoice</field>
        <field name="report_file">sf_connector.report_sf_invoice</field>
        <field name="print_report_name">(object.name or 'Invoice').replace('/', '-')</field>
        <field name="paperformat_id" ref="paperformat_sf_letter"/>
    </record>
    <record id="report_sf_invoice_gamma" model="ir.actions.report">
        <field name="name">Invoice (G.A.M.M.A)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sf_connector.report_sf_invoice</field>
        <field name="report_file">sf_connector.report_sf_invoice</field>
        <field name="print_report_name">(object.name or 'Invoice').replace('/', '-')</field>
        <field name="paperformat_id" ref="paperformat_sf_a4"/>
    </record>

    <!-- Own page layout: no date or company header (Odoo's standard one is not on the reference invoices). The page
         number is the footer, bottom right. -->
    <template id="sf_invoice_layout">
        <div class="header"/>
        <div class="footer" style="font-size: 8pt; color: #555;">
            <div style="text-align: right;"><span class="page"/> / <span class="topage"/></div>
        </div>
        <t t-out="0"/>
    </template>

    <template id="report_sf_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="sf_connector.report_sf_invoice_document" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="report_sf_invoice_document">
        <t t-set="c" t-value="o.company_id"/>
        <t t-set="gamma" t-value="c.sf_invoice_layout == 'gamma'"/>
        <t t-set="lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product' and not l.sf_information_only)"/>
        <t t-set="offers" t-value="o.sf_early_payment_offers()"/>
        <t t-call="sf_connector.sf_invoice_layout">
            <div class="sf-inv" style="font-size: 9.5pt; color: #222;">
                <!-- No cell borders in this layout: the reference has none. -->
                <style>
                    .sf-inv table, .sf-inv td, .sf-inv th { border: 0 !important; border-collapse: collapse; }
                    .sf-inv td, .sf-inv th { padding: 2px 4px; vertical-align: top; }
                </style>

                <!-- Top rule -->
                <div style="height: 4px; background: #4aa3e8; margin-bottom: 14px;"/>

                <!-- Header: logo left; title (and trading name) under it; company block right -->
                <table style="width: 100%;">
                    <tr>
                        <td style="width: 28%;">
                            <img t-if="c.logo" t-att-src="image_data_uri(c.logo)" style="max-height: 80px;" alt="Logo"/>
                        </td>
                        <td style="width: 36%;">
                            <div style="font-size: 15pt;">Invoice <strong t-esc="o.name"/></div>
                            <div t-if="gamma and c.sf_trading_name" style="margin-top: 22px;" t-esc="c.sf_trading_name"/>
                        </td>
                        <td style="width: 36%;">
                            <t t-if="not gamma">
                                <div><strong t-esc="c.name"/></div>
                                <div t-if="c.street" t-esc="c.street"/>
                                <div t-if="c.street2" t-esc="c.street2"/>
                                <div t-esc="o.sf_company_city_line()"/>
                                <div t-if="c.website" t-esc="c.website"/>
                                <div t-if="c.sf_tax_id">Tax ID: <span t-esc="c.sf_tax_id"/></div>
                            </t>
                            <t t-if="gamma">
                                <div t-if="c.sf_header_html" t-field="c.sf_header_html"/>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- Info row: Bill To, Date, PO #, TOTAL; second row: Tax Reg. Number, TERMS, Due Date -->
                <table style="width: 100%; margin-top: 26px;">
                    <tr>
                        <td rowspan="2" style="width: 34%;">
                            <div style="color: #1f5f99; font-weight: bold;">Bill To</div>
                            <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["name", "address"], "no_marker": true}'/>
                        </td>
                        <td style="width: 22%;">
                            <div style="color: #1f5f99; font-weight: bold;">Date</div>
                            <div t-esc="o.sf_format_date(o.invoice_date)"/>
                        </td>
                        <td style="width: 20%;">
                            <div style="color: #1f5f99; font-weight: bold;">PO #</div>
                            <div t-esc="o.sf_po_number()"/>
                        </td>
                        <td style="width: 24%; text-align: right;">
                            <div style="color: #1f5f99; font-weight: bold;">TOTAL</div>
                            <div style="font-size: 22pt;"><span t-esc="o.sf_money(o.amount_total)"/></div>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding-top: 8px;">
                            <div style="color: #1f5f99; font-weight: bold;">Tax Reg. Number</div>
                            <div t-esc="o.partner_id.vat or ''"/>
                        </td>
                        <td style="padding-top: 8px;">
                            <div style="color: #1f5f99; font-weight: bold;">TERMS</div>
                            <div t-esc="o.invoice_payment_term_id.name or ''"/>
                        </td>
                        <td style="padding-top: 8px; text-align: right;">
                            <span style="color: #1f5f99; font-weight: bold;">Due Date:</span>
                            <span t-esc="o.sf_format_date(o.invoice_date_due)"/>
                        </td>
                    </tr>
                </table>
                <div style="border-bottom: 2px solid #4aa3e8; margin-top: 12px;"/>

                <!-- Lines: product name, then the Salesforce description in italics in brackets -->
                <table style="width: 100%; margin-top: 10px;">
                    <thead>
                        <tr>
                            <th style="text-align: left; color: #1f5f99;">Item</th>
                            <t t-if="not gamma">
                                <th style="text-align: right; color: #1f5f99; width: 17%;">Total cost</th>
                                <th style="text-align: right; color: #1f5f99; width: 19%;">Amount invoiced</th>
                            </t>
                            <t t-if="gamma">
                                <th style="text-align: right; color: #1f5f99; width: 19%;">Amount</th>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="lines" t-as="line" style="border-top: 1px solid #e3e8ee;">
                            <td style="padding: 8px 4px;">
                                <span t-field="line.name"/><t t-if="line.sf_combined_description"> <i>(<span t-esc="line.sf_combined_description"/>)</i></t>
                            </td>
                            <t t-if="not gamma">
                                <td style="text-align: right; padding: 8px 4px;">
                                    <span t-esc="o.sf_money(line.sale_line_ids[:1].price_subtotal if line.sale_line_ids else line.price_subtotal)"/>
                                </td>
                                <td style="text-align: right; padding: 8px 4px;">
                                    <span t-esc="o.sf_money(line.price_subtotal)"/>
                                </td>
                            </t>
                            <t t-if="gamma">
                                <td style="text-align: right; padding: 8px 4px;">
                                    <span t-esc="o.sf_money(line.price_subtotal)"/>
                                </td>
                            </t>
                        </tr>
                    </tbody>
                </table>

                <!-- Totals, right aligned -->
                <table style="width: 46%; margin-left: auto; margin-top: 8px;">
                    <tr>
                        <td style="text-align: right; padding: 3px 6px;">Subtotal</td>
                        <td style="text-align: right; padding: 3px 4px; width: 42%;"><span t-esc="o.sf_money(o.amount_untaxed)"/></td>
                    </tr>
                    <tr>
                        <td style="text-align: right; padding: 3px 6px;">Tax<t t-if="gamma"> (<span t-esc="'%g' % round(100.0 * o.amount_tax / o.amount_untaxed, 2) if o.amount_untaxed else 0"/>%)</t></td>
                        <td style="text-align: right; padding: 3px 4px;"><span t-esc="o.sf_money(o.amount_tax)"/></td>
                    </tr>
                    <tr style="border-top: 1px solid #e3e8ee;">
                        <td style="text-align: right; padding: 5px 6px; color: #1f5f99; font-weight: bold;">Total</td>
                        <td style="text-align: right; padding: 5px 4px;"><span t-esc="o.sf_money(o.amount_total)"/></td>
                    </tr>
                </table>

                <!-- Left: wire information (LLC). Right: early payment discount offers (display only). -->
                <table style="width: 100%; margin-top: 16px;">
                    <tr>
                        <td style="width: 50%; padding-right: 10px;">
                            <t t-if="not gamma and c.sf_payment_html">
                                <div style="color: #1f5f99; font-weight: bold;">WIRE INFORMATION:</div>
                                <div t-field="c.sf_payment_html"/>
                            </t>
                        </td>
                        <td style="width: 50%;">
                            <t t-if="offers">
                                <div style="color: #1f5f99; font-weight: bold;">Early Payment Discount Offer:</div>
                                <table style="width: 100%; border: 1px solid #4aa3e8 !important; margin-top: 4px;">
                                    <t t-foreach="offers" t-as="offer">
                                        <tr>
                                            <td style="padding: 5px 8px; font-weight: bold;">
                                                Balance due if paid by <span t-esc="o.sf_format_date(offer['date'])"/>
                                                (-<span t-esc="'%g' % offer['percent']"/>%)
                                            </td>
                                            <td style="padding: 5px 8px; text-align: right; font-weight: bold;">
                                                <span t-esc="o.sf_money(offer['amount'])"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </t>
                        </td>
                    </tr>
                </table>

                <!-- LLC: legal payment paragraph, then Notes. G.A.M.M.A: Notes, then Payment instructions. -->
                <div t-if="not gamma and c.sf_legal_html" style="margin-top: 12px;" t-field="c.sf_legal_html"/>
                <div t-if="c.sf_notes_html" style="margin-top: 12px;">
                    <div style="color: #1f5f99; font-weight: bold;">Notes</div>
                    <div t-field="c.sf_notes_html"/>
                </div>
                <div t-if="gamma and c.sf_payment_html" style="margin-top: 12px;">
                    <div style="color: #1f5f99; font-weight: bold;">Payment instructions</div>
                    <div t-field="c.sf_payment_html"/>
                </div>

                <!-- Footer text, from Settings → Companies (never hard-coded) -->
                <div t-if="c.sf_footer_html" style="margin-top: 40px; text-align: center; font-size: 8.5pt;" t-field="c.sf_footer_html"/>
            </div>
        </t>
    </template>
</odoo>
