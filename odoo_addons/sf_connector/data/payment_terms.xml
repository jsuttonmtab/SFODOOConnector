<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Salesforce Payment_Terms__c values, synced by name.
        "Net X": due X days after invoice date.
        "Net X EOM": due X days after the end of the invoice month.
        "Net 45 PSA": meaning not yet confirmed by Finance; treated as Net 45.
        noupdate: Finance may edit these in Odoo without an upgrade overwriting them.
    -->
    <data noupdate="1">
        <record id="sf_payment_term_net_30" model="account.payment.term">
            <field name="name">Net 30</field>
            <field name="line_ids" eval="[(0, 0, {'value': 'percent', 'value_amount': 100.0, 'nb_days': 30, 'delay_type': 'days_after'})]"/>
        </record>
        <record id="sf_payment_term_net_30_eom" model="account.payment.term">
            <field name="name">Net 30 EOM</field>
            <field name="line_ids" eval="[(0, 0, {'value': 'percent', 'value_amount': 100.0, 'nb_days': 30, 'delay_type': 'days_after_end_of_month'})]"/>
        </record>
