<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings → Companies: the invoice layout and its per-company text (sf_connector). -->
    <record id="res_company_form_sf_connector" model="ir.ui.view">
        <field name="name">res.company.form.sf_connector</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Invoice Layout" name="sf_invoice_layout">
                    <group>
                        <group string="Layout">
                            <field name="sf_invoice_layout"/>
                            <field name="sf_trading_name"/>
                            <field name="sf_tax_id"/>
                        </group>
                        <group string="Early Payment Offers (display only)">
                            <field name="sf_epd_days_1"/>
                            <field name="sf_epd_percent_1"/>
                            <field name="sf_epd_days_2"/>
                            <field name="sf_epd_percent_2"/>
                        </group>
                    </group>
                    <group string="Text">
                        <field name="sf_header_html"/>
                        <field name="sf_notes_html"/>
                        <field name="sf_payment_html"/>
                        <field name="sf_legal_html"/>
                        <field name="sf_footer_html"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
