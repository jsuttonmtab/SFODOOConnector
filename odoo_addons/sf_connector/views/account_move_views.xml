<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The Salesforce description of each invoice line, read only, so Finance can check it before posting. -->
    <record id="view_move_form_sf_connector" model="ir.ui.view">
        <field name="name">account.move.form.sf_connector</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="sf_combined_description" string="Item Description" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
