# Copy to connector/.env and fill in. .env is git-ignored.
# Create the API key in Odoo: Preferences > Account Security > New API Key.
ODOO_URL=http://10.10.100.25:8069
ODOO_DB=OdooSandbox19
ODOO_API_KEY=
# Optional: login of the user that owns the API key (only used for a warning).
ODOO_API_LOGIN=

# Salesforce login. With SF_CLIENT_ID and SF_CLIENT_SECRET set, the connector uses the OAuth
# client-credentials flow (External Client App). Both empty: it uses the sf CLI login below.
# SF_CLIENT_SECRET is a secret: never commit or paste it.
SF_LOGIN_URL=https://YOUR-DOMAIN.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# sf CLI org alias (sf org list). Used only when SF_CLIENT_ID is empty.
SF_TARGET_ORG=mtab-sandbox

# Odoo -> Salesforce write-back of Odoo ids, links and errors (docs/field-mapping.md §5.1).
# Nothing is written to Salesforce unless SF_WRITEBACK is true. Dry runs work either way.
SF_WRITEBACK=false
# Writes are refused unless the authenticated org Id is this one (18 characters).
SF_EXPECTED_ORG_ID=
# URL users open Odoo at. Used to build the Odoo_Record__c links.
ODOO_PUBLIC_URL=https://odoo.example.com

# Odoo login (not name) of the Finance user who gets a To Do when an opportunity leaves
# stage 07 or Closed (docs/field-mapping.md §4.6). Leave empty to skip the activity.
FINANCE_ACTIVITY_USER=

# Create a service product in Odoo when a Salesforce product has no match (warns). Default false.
AUTO_CREATE_PRODUCTS=false

# Project set on connector-managed orders (Delivery Tracker lists by project name).
# Exact name of an active, billable project. Set only on orders that have no project yet.
DELIVERABLES_PROJECT=DS deliverables
